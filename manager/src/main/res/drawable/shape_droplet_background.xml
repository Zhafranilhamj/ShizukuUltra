<?xml version="1.0" encoding="utf-8"?>
<!-- Droplet-shaped icon container for card icons. The asymmetric corners (one squared, others
     fully rounded) give it a water-/paint-drop feel, tying into the Liquid Glass theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="12dp"
        android:topRightRadius="48dp"
        android:bottomLeftRadius="48dp"
        android:bottomRightRadius="48dp" />
    <solid android:color="@android:color/white" />
</shape>
