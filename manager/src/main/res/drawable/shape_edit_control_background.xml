<?xml version="1.0" encoding="utf-8"?>
<!-- Glass-pill edit control background for card drag/remove buttons. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="?attr/glassChipSurface" />
    <stroke
        android:width="1dp"
        android:color="?attr/glassChipStroke" />
</shape>
