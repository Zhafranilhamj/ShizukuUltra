<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid Glass card background.
  A subtle inner/outer gradient that mimics light refracting through a polished glass surface:
  bright top/inner highlight, soft bottom shadow, and a faint outline on the edge. Used on
  MaterialCardViews as a foreground overlay (via cardForeground) on top of a translucent card
  background so the BlurView behind shows through.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#14FFFFFF"
        android:centerColor="#08FFFFFF"
        android:endColor="#00000000" />
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF" />
</shape>
